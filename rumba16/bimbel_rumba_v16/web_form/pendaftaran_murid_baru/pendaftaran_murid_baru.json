 "client_script": "var rumba_unit_by_name = {};\r\nvar EMAIL_RUMBA_INDUK = \"rumba.united@gmail.com\";\r\n\r\nfunction toggle_field(fieldname, show) {\r\n\tfrappe.web_form.set_df_property(fieldname, \"hidden\", show ? 0 : 1);\r\n\r\n\tif (!show) {\r\n\t\tfrappe.web_form.set_value(fieldname, \"\");\r\n\t}\r\n}\r\n\r\nfunction toggle_fields() {\r\n\ttoggle_field(\"nama_sekolah\", frappe.web_form.get_value(\"anak_sudah_sekolah\") === \"Ya\");\r\n\ttoggle_field(\"kelas\", frappe.web_form.get_value(\"anak_sudah_sekolah\") === \"Ya\");\r\n\ttoggle_field(\"jelaskan_kebutuhan_khusus_anak\", frappe.web_form.get_value(\"anak_berkebutuhan_khusus\") === \"Ya\");\r\n\ttoggle_field(\"nama_saudara\", frappe.web_form.get_value(\"saudara_di_rumba\") === \"Ya\");\r\n\ttoggle_field(\"belajar_di_unit_rumba\", frappe.web_form.get_value(\"saudara_di_rumba\") === \"Ya\");\r\n\ttoggle_field(\"durasi_les\", frappe.web_form.get_value(\"les_serupa\") === \"Ya\");\r\n\ttoggle_field(\"level_yang_dicapai\", frappe.web_form.get_value(\"les_serupa\") === \"Ya\");\r\n\ttoggle_field(\"nama_tempat_les\", frappe.web_form.get_value(\"les_serupa\") === \"Ya\");\r\n\ttoggle_field(\"untuk_jawaban_lainnya\", Boolean(frappe.web_form.get_value(\"lainnya\")));\r\n\ttoggle_field(\"ukuran_kaos\", Boolean(frappe.web_form.get_value(\"kaos\")));\r\n}\r\n\r\nfunction set_hidden_value(fieldname, value) {\r\n\tif (frappe.web_form.fields_dict[fieldname]) {\r\n\t\tfrappe.web_form.set_value(fieldname, value || \"\");\r\n\t}\r\n}\r\n\r\nfunction set_email_rumba_induk() {\r\n\tset_hidden_value(\"email_rumba_induk\", EMAIL_RUMBA_INDUK);\r\n}\r\n\r\nfunction set_tanggal_pendaftaran() {\r\n\tif (frappe.web_form.fields_dict.tanggal_pendaftaran) {\r\n\t\tfrappe.web_form.set_value(\r\n\t\t\t\"tanggal_pendaftaran\",\r\n\t\t\tfrappe.datetime.get_today()\r\n\t\t);\r\n\t}\r\n}\r\n\r\nfunction refresh_select_field(fieldname, options) {\r\n\tvar field = frappe.web_form.fields_dict[fieldname];\r\n\r\n\tif (!field) {\r\n\t\tconsole.warn(\"Field tidak ditemukan:\", fieldname);\r\n\t\treturn;\r\n\t}\r\n\r\n\tfield.df.options = options.join(\"\\n\");\r\n\r\n\tif (field.$input) {\r\n\t\tfield.$input.empty();\r\n\r\n\t\toptions.forEach(function(option) {\r\n\t\t\tfield.$input.append(\r\n\t\t\t\t$(\"<option></option>\").attr(\"value\", option).text(option)\r\n\t\t\t);\r\n\t\t});\r\n\t}\r\n\r\n\tfield.refresh();\r\n}\r\n\r\nfunction clear_unit_options() {\r\n\trumba_unit_by_name = {};\r\n\r\n\tset_hidden_value(\"nama_unit\", \"\");\r\n\tset_hidden_value(\"kode_unit\", \"\");\r\n\tset_hidden_value(\"email_unit\", \"\");\r\n\r\n\trefresh_select_field(\"nama_unit\", [\"\"]);\r\n}\r\n\r\nfunction set_unit_options(units) {\r\n\trumba_unit_by_name = {};\r\n\r\n\tvar options = [\"\"];\r\n\r\n\tunits.forEach(function(unit) {\r\n\t\tvar unit_value = unit.name || unit.nama_unit;\r\n\r\n\t\tif (unit_value) {\r\n\t\t\toptions.push(unit_value);\r\n\t\t\trumba_unit_by_name[unit_value] = unit;\r\n\t\t}\r\n\t});\r\n\r\n\tset_hidden_value(\"nama_unit\", \"\");\r\n\tset_hidden_value(\"kode_unit\", \"\");\r\n\tset_hidden_value(\"email_unit\", \"\");\r\n\r\n\trefresh_select_field(\"nama_unit\", options);\r\n}\r\n\r\nfunction load_unit_options(kode_kota) {\r\n\tif (!kode_kota) {\r\n\t\tclear_unit_options();\r\n\t\treturn;\r\n\t}\r\n\r\n\tclear_unit_options();\r\n\r\n\tfrappe.call({\r\n\t\tmethod: \"get_rumba_units_by_kota\",\r\n\t\targs: {\r\n\t\t\tkode_kota: kode_kota\r\n\t\t},\r\n\t\tcallback: function(response) {\r\n\t\t\tvar units = response.message || [];\r\n\t\t\tset_unit_options(units);\r\n\t\t},\r\n\t\terror: function(error) {\r\n\t\t\tconsole.error(\"Gagal mengambil unit:\", error);\r\n\t\t\tclear_unit_options();\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction ubah_tombol_sukses_webform() {\r\n\tvar interval = setInterval(function() {\r\n\t\tvar buttons = document.querySelectorAll(\"a, button\");\r\n\r\n\t\tbuttons.forEach(function(button) {\r\n\t\t\tvar text = (button.innerText || button.textContent || \"\").trim();\r\n\r\n\t\t\tif (text === \"Submit another response\") {\r\n\t\t\t\tbutton.innerText = \"Kembali ke beranda\";\r\n\r\n\t\t\t\tbutton.onclick = function(event) {\r\n\t\t\t\t\tevent.preventDefault();\r\n\t\t\t\t\twindow.location.href = \"https://bimbelrumba.id\";\r\n\t\t\t\t};\r\n\r\n\t\t\t\tif (button.tagName.toLowerCase() === \"a\") {\r\n\t\t\t\t\tbutton.setAttribute(\"href\", \"https://bimbelrumba.id\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\tclearInterval(interval);\r\n\t\t\t}\r\n\t\t});\r\n\t}, 300);\r\n}\r\n\r\nfrappe.web_form.after_load = function() {\r\n\ttoggle_fields();\r\n\tset_email_rumba_induk();\r\n\tset_tanggal_pendaftaran();\r\n\tload_unit_options(frappe.web_form.get_value(\"nama_kota\"));\r\n\tubah_tombol_sukses_webform();\r\n};\r\n\r\nfrappe.web_form.after_save = function() {\r\n\tubah_tombol_sukses_webform();\r\n};\r\n\r\nfrappe.web_form.on(\"nama_kota\", function(field, value) {\r\n\tload_unit_options(value);\r\n});\r\n\r\nfrappe.web_form.on(\"nama_unit\", function(field, value) {\r\n\tvar unit = rumba_unit_by_name[value];\r\n\r\n\tset_hidden_value(\r\n\t\t\"kode_unit\",\r\n\t\tunit && unit.kode_unit ? unit.kode_unit : \"\"\r\n\t);\r\n\r\n\tset_hidden_value(\r\n\t\t\"email_unit\",\r\n\t\tunit && unit.email_unit ? unit.email_unit : \"\"\r\n\t);\r\n\r\n\tset_email_rumba_induk();\r\n});\r\n\r\nfrappe.web_form.on(\"anak_sudah_sekolah\", function() { toggle_fields(); });\r\nfrappe.web_form.on(\"anak_berkebutuhan_khusus\", function() { toggle_fields(); });\r\nfrappe.web_form.on(\"saudara_di_rumba\", function() { toggle_fields(); });\r\nfrappe.web_form.on(\"les_serupa\", function() { toggle_fields(); });\r\nfrappe.web_form.on(\"lainnya\", function() { toggle_fields(); });\r\nfrappe.web_form.on(\"kaos\", function() { toggle_fields(); });",
