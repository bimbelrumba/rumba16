 "client_script": "(function () {\n    var last = null;\n    var initialized = false;\n    setInterval(function () {\n        if (!window.frappe || !frappe.web_form || !frappe.web_form.fields_dict || !frappe.web_form.fields_dict.nama_unit) return;\n        var kota = frappe.web_form.get_value('nama_kota') || '';\n        if (kota === last) return;\n        var wasInitialized = initialized;\n        last = kota;\n        initialized = true;\n        if (!kota) {\n            frappe.web_form.set_df_property('nama_unit', 'options', '');\n            return;\n        }\n        if (wasInitialized) {\n            frappe.web_form.set_value('nama_unit', '');\n        }\n        frappe.call({\n            method: 'get_rumba_units_by_kota',\n            args: { kode_kota: kota },\n            callback: function (r) {\n                var units = (r.message || []).map(function (u) { return u.nama_unit || u.name; });\n                frappe.web_form.set_df_property('nama_unit', 'options', '\\n' + units.join('\\n'));\n            }\n        });\n    }, 500);\n})();",
